# ======================================================================
# BRIANA · Variables de entorno (desarrollo local)
# En producción (Render) define estas mismas claves en el panel del servicio.
# ======================================================================

# --- Base de datos: local en desarrollo / Neon PostgreSQL en producción ---
# Ejemplo Neon: postgresql://USER:PASSWORD@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# DATABASE_SSL=true            # (se activa solo cuando el host no es local)
# DATABASE_SSL_STRICT=false    # true para exigir certificado verificado

# --- Seguridad de sesiones (JWT HS256 firmado en el servidor) ---
JWT_SECRET=cambia-esto-por-una-cadena-aleatoria-larga
SESSION_DAYS=7

# --- Administrador único del sistema (no admite registro abierto) ---
ADMIN_EMAIL=administrador@gmail.com
ADMIN_PASSWORD=define-una-contrasena-maestra-segura
ADMIN_NAME=administrador

# --- Correo SMTP (nodemailer) para códigos de 6 dígitos ---
# Con Gmail usa una "Contraseña de aplicación" (no la contraseña normal).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
# EMAIL_SERVICE=gmail          # alternativa a HOST/PORT
CODE_TTL_MINUTES=15
RESEND_COOLDOWN_SECONDS=60

# --- IA (Gemini). Si se define aquí, tiene prioridad sobre la clave del panel Servidor ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Tutor de demostración (opcional; elimina estas líneas en producción) ---
DEMO_TUTOR_NAME=Elias Vargas
DEMO_TUTOR_EMAIL=eliasvargas@gmail.com
DEMO_TUTOR_PASSWORD=
